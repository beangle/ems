{
  "name": "@beangle/ems-app",
  "version": "0.0.2-SNAPSHOT",
  "description": "EMS 应用侧接入层：登录会话与 token、权限对接、运行时配置、微前端（Wujie）集成、门户 UI（语言/主题/字号）同步",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beangle/ems.git",
    "directory": "packages/ems-app"
  },
  "homepage": "https://github.com/beangle/ems/tree/master/packages/ems-app",
  "bugs": {
    "url": "https://github.com/beangle/ems/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pc": {
      "types": "./dist/pc.d.ts",
      "default": "./dist/pc.js"
    },
    "./dist/index.css": "./dist/index.css",
    "./styles/app-shell.css": "./src/styles/app-shell.css"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "prepublishOnly": "pnpm run build",
    "release:prepare": "bash scripts/release-prepare.sh",
    "release:finish": "bash scripts/release-finish.sh",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "peerDependenciesMeta": {
    "tdesign-icons-vue-next": {
      "optional": true
    },
    "tdesign-vue-next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.1",
    "tdesign-icons-vue-next": "^0.4.0",
    "tdesign-vue-next": "^1.20.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.1.0"
  },
  "keywords": [
    "beangle",
    "ems",
    "wujie",
    "cas",
    "permission"
  ]
}
