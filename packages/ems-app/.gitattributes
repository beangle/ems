* text=auto

# Normalize text files to LF.
*.css     text eol=lf
*.html    text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.mjs     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.vue     text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf

# Binary assets.
*.gif     binary
*.ico     binary
*.jpg     binary
*.jpeg    binary
*.png     binary
*.webp    binary
*.woff    binary
*.woff2   binary
